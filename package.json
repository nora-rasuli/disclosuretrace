    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "jest-axe": "11.0.0",
    "jsdom": "27.2.0",
    "lighthouse": "^13.6.0",
    "prettier": "3.7.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.2.6",
    "vitest": "5.1.0"
