    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:e2e": "playwright test",
    "fixtures:generate": "tsx scripts/ingest-sec.ts --generate",
    "fixtures:curated": "tsx scripts/generate-curated-fixtures.ts",
    "fixtures:check": "tsx scripts/check-determinism.ts",
    "sources:verify": "tsx scripts/verify-sources.ts",
